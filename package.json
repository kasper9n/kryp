		"@tauri-apps/cli": "^1.6.3",
		"@tsconfig/svelte": "^5.0.4",
		"@typescript-eslint/eslint-plugin": "^6.21.0",
		"@typescript-eslint/parser": "^6.21.0",
		"autoprefixer": "^10.4.21",
		"chart.js": "^4.4.8",
		"date-picker-svelte": "^2.16.0",
		"eslint": "^8.57.1",
