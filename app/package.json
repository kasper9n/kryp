{
  "private": true,
  "scripts": {
    "dev": "run-p dev:routify dev:svite",
    "dev:routify": "routify run",
    "dev:svite": "svite dev -ts --port $SERVER_PORT",
    "build": "run-p build:routify build:svite",
    "build:routify": "routify run --single-build",
    "build:svite": "svite build -ts",
    "lint": "svelte-check && tsc --noEmit"
  },
  "dependencies": {
    "@roxi/routify": "^2.0.2"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "pug": "^3.0.0",
    "sass": "^1.26.11",
    "svelte": "3.29.0",
    "svelte-check": "^1.0.55",
    "svelte-hmr": "0.11.1",
    "svelte-preprocess": "4.4.2",
    "svite": "^0.7.2",
    "typescript": "^4.0.3",
    "tslib": "^2.0.1",
    "@tsconfig/svelte": "^1.0.10"
  }
}
