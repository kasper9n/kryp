{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kryp",
  "identifier": "space.kasper.kryp",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:5448",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../build"
  },
  "mainBinaryName": "Kryp",
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "deb",
      "appimage",
      "msi"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "© 2024 kasper.space",
    "category": "Finance",
    "shortDescription": "Cryptocurrency tax calculator",
    "longDescription": "",
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.13",
      "exceptionDomain": "",
      "signingIdentity": null,
      "entitlements": null
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {},
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'unsafe-inline' *; style-src 'unsafe-inline' *; connect-src ipc: http://ipc.localhost"
    }
  }
}
